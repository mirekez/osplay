+#if DROPBEAR_OSPLAY_SFTP && DROPBEAR_SERVER
+/* Consume input from the SSH receive window and send one bounded SFTP reply
+ * at a time. Run before select so queued replies wake the socket writer. */
+static void sftp_channel_io(struct Channel *channel) {
+	while (ses.dataallowed && !channel->sent_close &&
+			ses.writequeue_len <= 2*TRANS_MAX_PAYLOAD_LEN) {
+		const unsigned char *output;
+		size_t size = osplay_sftp_output(channel->sftp, &output);
+		if (size) {
+			size = MIN(size, channel->transwindow);
+			size = MIN(size, channel->transmaxpacket);
+			size = MIN(size, ses.writepayload->size - 9);
+			if (!size) break;
+			CHECKCLEARTOWRITE();
+			buf_putbyte(ses.writepayload, SSH_MSG_CHANNEL_DATA);
+			buf_putint(ses.writepayload, channel->remotechan);
+			buf_putstring(ses.writepayload, output, size);
+			channel->transwindow -= size;
+			osplay_sftp_sent(channel->sftp, size);
+			encrypt_packet();
+		} else {
+			unsigned char *p1, *p2;
+			unsigned int len1, len2;
+			cbuf_readptrs(channel->writebuf, &p1, &len1, &p2, &len2);
+			if (!len1) break;
+			size = osplay_sftp_feed(channel->sftp, p1, len1);
+			if (!size) break;
+			cbuf_incrread(channel->writebuf, size);
+			channel->recvdonelen += size;
+		}
+	}
+	if (ses.dataallowed && !channel->sent_close &&
+		channel->recvdonelen >= RECV_WINDOWEXTEND) {
+		send_msg_channel_window_adjust(channel, channel->recvdonelen);
+		channel->recvwindow += channel->recvdonelen;
+		channel->recvdonelen = 0;
+	}
+}
+#endif
+
